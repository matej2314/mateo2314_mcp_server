  "item": [
    {
      "name": "4.1 Health check",
      "description": "Krok 4.1 — `GET /healthz`. Bez Bearer. Oczekiwany `status: ok` oraz check `trilium_etapi` z `ok: true`.",
      "item": [
        {
          "name": "GET /healthz",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"healthz HTTP 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"payload status ok + trilium_etapi\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property(\"status\", \"ok\");",
                  "  pm.expect(body.checks).to.be.an(\"array\");",
                  "  const trilium = body.checks.find(",
                  "    (c) => c.id === \"trilium_etapi\" || c.id === \"trilium_etapi_health\"",
                  "  );",
                  "  pm.expect(trilium, \"brak checka trilium_etapi — włącz ENABLE_MODULE_TRILIUM i token ETAPI\").to.exist;",
                  "  pm.expect(trilium.ok).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "auth": {
            "type": "noauth"
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{mcp_base_url}}/healthz",
              "host": ["{{mcp_base_url}}"],
              "path": ["healthz"]
            },
            "description": "Sonda zdrowia. Jeśli check Trilium jest `false`: `TRILIUM_BASE_URL` (Docker: `http://trilium:8080`) i `TRILIUM_API_TOKEN`."
          },
          "response": [
            {
              "name": "healthz ok",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{mcp_base_url}}/healthz",
                  "host": ["{{mcp_base_url}}"],
                  "path": ["healthz"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"status\": \"ok\",\n  \"checks\": [\n    { \"id\": \"portfolio_content_root\", \"ok\": true },\n    { \"id\": \"trilium_etapi\", \"ok\": true, \"detail\": \"appVersion=0.95.0\" }\n  ]\n}"
            }
          ]
        }
      ]
