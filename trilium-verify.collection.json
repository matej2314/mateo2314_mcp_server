    {
      "name": "MCP Server — Trilium module",
      "description": "Krok 4.2 — Streamable HTTP JSON-RPC pod `/mcp/{{mcp_namespace}}`.\n\nWymaga Bearer `MCP_INTERNAL_TOKEN`. Po A zapisz `mcp-session-id` i wołaj B–D z tym nagłówkiem.\nA2 (`notifications/initialized`) jest handshake’em MCP między initialize a `tools/list`.",
      "item": [
        {
          "name": "A — Initialize session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function parseMcpJson() {",
                  "  const raw = pm.response.text();",
                  "  const ct = String(pm.response.headers.get(\"Content-Type\") || \"\").toLowerCase();",
                  "  const looksSse =",
                  "    ct.includes(\"text/event-stream\") ||",
                  "    raw.trim().startsWith(\"event:\") ||",
                  "    raw.includes(\"\\ndata:\");",
                  "  if (!looksSse) {",
                  "    return JSON.parse(raw);",
                  "  }",
                  "  const payloads = [];",
                  "  raw.split(/\\r?\\n\\r?\\n/).forEach((block) => {",
                  "    const data = block",
                  "      .split(/\\r?\\n/)",
                  "      .filter((line) => line.startsWith(\"data:\"))",
                  "      .map((line) => line.replace(/^data:\\s*/, \"\"))",
                  "      .join(\"\\n\");",
                  "    if (!data) return;",
                  "    try {",
                  "      payloads.push(JSON.parse(data));",
                  "    } catch (e) {}",
                  "  });",
                  "  const rpc = payloads.filter((p) => p && (p.result !== undefined || p.error !== undefined));",
                  "  pm.expect(rpc.length, \"JSON-RPC w SSE\").to.be.above(0);",
                  "  return rpc[rpc.length - 1];",
                  "}",
                  "",
                  "pm.test(\"initialize HTTP 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"mcp-session-id zapisany\", () => {",
                  "  const sid = pm.response.headers.get(\"mcp-session-id\");",
                  "  pm.expect(sid, \"brak nagłówka mcp-session-id\").to.be.ok;",
                  "  pm.collectionVariables.set(\"session_id\", sid);",
                  "  pm.environment.set(\"session_id\", sid);",
                  "});",
                  "",
                  "pm.test(\"JSON-RPC initialize result\", () => {",
                  "  const body = parseMcpJson();",
                  "  pm.expect(body.error, JSON.stringify(body.error || null)).to.not.exist;",
                  "  pm.expect(body.result).to.be.an(\"object\");",
                  "  pm.expect(body.result).to.have.property(\"protocolVersion\");",
                  "  pm.expect(body.result).to.have.property(\"capabilities\");",
                  "  pm.expect(body.result).to.have.property(\"serverInfo\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"initialize\",\n  \"params\": {\n    \"protocolVersion\": \"2025-03-26\",\n    \"capabilities\": {},\n    \"clientInfo\": { \"name\": \"postman-test\", \"version\": \"1.0\" }\n  }\n}",
              "options": {
