                  "  const ct = String(pm.response.headers.get(\"Content-Type\") || \"\").toLowerCase();",
                  "  const looksSse =",
                  "    ct.includes(\"text/event-stream\") ||",
                  "    raw.trim().startsWith(\"event:\") ||",
                  "    raw.includes(\"\\ndata:\");",
                  "  if (!looksSse) {",
                  "    return JSON.parse(raw);",
                  "  }",
                  "  const payloads = [];",
                  "  raw.split(/\\r?\\n\\r?\\n/).forEach((block) => {",
                  "    const data = block",
                  "      .split(/\\r?\\n/)",
                  "      .filter((line) => line.startsWith(\"data:\"))",
                  "      .map((line) => line.replace(/^data:\\s*/, \"\"))",
                  "      .join(\"\\n\");",
                  "    if (!data) return;",
                  "    try {",
                  "      payloads.push(JSON.parse(data));",
                  "    } catch (e) {}",
                  "  });",
                  "  const rpc = payloads.filter((p) => p && (p.result !== undefined || p.error !== undefined));",
