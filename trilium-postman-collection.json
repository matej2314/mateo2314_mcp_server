        {
          "name": "GET /etapi/notes/root/children (brak w ETAPI)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"GET /children nie jest trasą ETAPI\", () => {",
                  "  pm.expect(pm.response.code).to.be.within(400, 499);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property(\"message\");",
                  "  pm.expect(String(body.message)).to.include(\"Router not found\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{trilium_base_url}}/etapi/notes/root/children",
              "host": [
                "{{trilium_base_url}}"
              ],
              "path": [
                "etapi",
                "notes",
                "root",
                "children"
              ]
            },
            "description": "Potwierdzone na żywej instancji: **brak trasy**. Odpowiedź: `{ \"message\": \"Router not found for request GET /etapi/notes/root/children\" }`. Drzewo wyłącznie przez `GET /etapi/notes/{noteId}` → `childNoteIds`. Ten request zostaje jako test negatywny (regresja)."
          },
          "response": [
            {
              "name": "Router not found",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{trilium_base_url}}/etapi/notes/root/children",
                  "host": [
                    "{{trilium_base_url}}"
                  ],
                  "path": [
                    "etapi",
                    "notes",
                    "root",
                    "children"
                  ]
                }
              },
              "status": "Not Found",
              "code": 404,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"Router not found for request GET /etapi/notes/root/children\"\n}"
            }
          ]
        },
        {
          "name": "GET /etapi/notes — hierarchia (ancestorNoteId=root)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"SearchResponse z topologią\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property(\"results\");",
                  "  pm.expect(body.results).to.be.an(\"array\").that.is.not.empty;",
                  "  body.results.forEach((note) => {",
                  "    pm.expect(note).to.include.keys(\"noteId\", \"title\", \"parentNoteIds\", \"childNoteIds\");",
                  "  });",
                  "});",
                  "",
                  "pm.test(\"root jest w results i nie ma rodziców\", () => {",
                  "  const byId = Object.fromEntries(pm.response.json().results.map((n) => [n.noteId, n]));",
                  "  pm.expect(byId).to.have.property(\"root\");",
                  "  pm.expect(byId.root.parentNoteIds).to.be.an(\"array\").that.is.empty;",
                  "  pm.expect(byId.root.childNoteIds).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"log krawędzi bez węzła w results\", () => {",
                  "  const results = pm.response.json().results;",
                  "  const ids = new Set(results.map((n) => n.noteId));",
                  "  const missing = [];",
                  "  for (const note of results) {",
                  "    for (const childId of note.childNoteIds || []) {",
                  "      if (!ids.has(childId)) {",
                  "        missing.push(note.noteId + \" → \" + childId);",
                  "      }",
                  "    }",
                  "  }",
                  "  console.log(\"Hierarchia: childNoteIds bez obiektu w results:\", missing);",
                  "  pm.expect(true).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{trilium_base_url}}/etapi/notes?search=note.noteId+%21%3D+%27%27&ancestorNoteId=root",
              "host": [
                "{{trilium_base_url}}"
              ],
              "path": [
                "etapi",
                "notes"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "note.noteId != ''",
                  "description": "Obowiązkowy parametr ETAPI. Warunek „dowolne noteId” — nie filtruje hierarchii, tylko omija błąd SEARCH_QUERY_PARAM_MANDATORY."
                },
                {
                  "key": "ancestorNoteId",
                  "value": "root",
                  "description": "Ogranicza wyniki do poddrzewa tej notatki (tu cały dokument od roota)."
                }
              ]
            },
            "description": "Hierarchia z **jednego** searcha, bez `GET /children` (tej trasy nie ma).\n\n**Co robi request**\n- `GET /etapi/notes` zwraca `SearchResponse`: `{ results: Note[] }` — **płaska lista**, nie zagnieżdżony JSON.\n- `search=note.noteId != ''` jest wymagane przez ETAPI (bez `search` → 400). To nie jest zapytanie o drzewo, tylko „jakakolwiek notatka”.\n- `ancestorNoteId=root` obcina zbiór do poddrzewa roota.\n\n**Jak z listy wynika drzewo**\nKażdy element `results` ma `parentNoteIds` i `childNoteIds` (oraz `parentBranchIds` / `childBranchIds`, konwencja gałęzi `{parentNoteId}_{childNoteId}`). Hierarchię składasz po stronie klienta: mapa `noteId → notatka`, krawędzie rodzic → dziecko.\n\nPrzykład z żywej instancji (ten sam kształt body co example poniżej):\n```\nroot\n├── Calendar              (#calendarRoot) → 2026 → 09 - September → 21 - Monday → test note\n├── Nowy tytuł            (liść; PATCH tytułu z kroku 1.8)\n├── MCP save test         (POST create-note)\n│   └── child test note\n└── Hidden Notes          (_hidden; typ doc)\n```\n`GET /etapi/notes/root` pokazałby tylko bezpośrednie `childNoteIds` roota — **bez** wnuka `child test note`. Ten search zwraca też głębiej, bo każda notatka w `results` niesie własne dzieci.\n\n**Czego ten JSON nie gwarantuje**\nLista **nie musi** zawierać obiektu dla każdego ID z `childNoteIds`. Na żywej odpowiedzi `_hidden` wymienia m.in. `_search`, `_globalNoteMap`, `_options`, a tych notatek nie było w `results`. Krawędź jest, węzła nie ma — nie traktuj tego requestu jako kompletnego dumpa bazy.\n\n**PoC MCP:** tańsza alternatywa niż N× `GET /etapi/notes/{id}` przy BFS. `trilium_get_tree` z planu i tak może iść po `childNoteIds` z metadanych; ten search jest kontraktem „płaska lista + topologia do złożenia grafu”. Systemowy folder `_hidden` przy składaniu grafu użytkownika zwykle odfiltrować."
          },
          "response": [
            {
              "name": "SearchResponse — płaska lista z topologią",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{trilium_base_url}}/etapi/notes?search=note.noteId+%21%3D+%27%27&ancestorNoteId=root",
                  "host": [
                    "{{trilium_base_url}}"
                  ],
                  "path": [
                    "etapi",
                    "notes"
                  ],
                  "query": [
                    {
                      "key": "search",
                      "value": "note.noteId != ''"
                    },
                    {
                      "key": "ancestorNoteId",
                      "value": "root"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"results\": [\n    {\n      \"noteId\": \"root\",\n      \"isProtected\": false,\n      \"title\": \"root\",\n      \"type\": \"text\",\n      \"mime\": \"text/html\",\n      \"blobId\": \"z4PhNX7vuL3xVChQ1m2A\",\n      \"parentNoteIds\": [],\n      \"childNoteIds\": [\"J9uABRItlGs7\", \"YgeSM5BvkCkr\", \"JMRbH5DNNlaI\", \"_hidden\"],\n      \"parentBranchIds\": [\"none_root\"],\n      \"childBranchIds\": [\"root_J9uABRItlGs7\", \"root_YgeSM5BvkCkr\", \"root_JMRbH5DNNlaI\", \"root__hidden\"],\n      \"attributes\": []\n    },\n    {\n      \"noteId\": \"J9uABRItlGs7\",\n      \"title\": \"Calendar\",\n      \"type\": \"text\",\n      \"parentNoteIds\": [\"root\"],\n      \"childNoteIds\": [\"ZggnryaxcDGg\"],\n      \"attributes\": [{ \"type\": \"label\", \"name\": \"calendarRoot\", \"value\": \"\" }]\n    },\n    {\n      \"noteId\": \"YgeSM5BvkCkr\",\n      \"title\": \"Nowy tytuł\",\n      \"type\": \"text\",\n      \"parentNoteIds\": [\"root\"],\n      \"childNoteIds\": []\n    },\n    {\n      \"noteId\": \"JMRbH5DNNlaI\",\n      \"title\": \"MCP save test\",\n      \"type\": \"text\",\n      \"parentNoteIds\": [\"root\"],\n      \"childNoteIds\": [\"FrTwXtfUNHOy\"]\n    },\n    {\n      \"noteId\": \"FrTwXtfUNHOy\",\n      \"title\": \"child test note\",\n      \"type\": \"text\",\n      \"parentNoteIds\": [\"JMRbH5DNNlaI\"],\n      \"childNoteIds\": []\n    },\n    {\n      \"noteId\": \"ZggnryaxcDGg\",\n      \"title\": \"2026\",\n      \"parentNoteIds\": [\"J9uABRItlGs7\"],\n      \"childNoteIds\": [\"LwzU9K5zUjXn\"]\n    },\n    {\n      \"noteId\": \"_hidden\",\n      \"title\": \"Hidden Notes\",\n      \"type\": \"doc\",\n      \"parentNoteIds\": [\"root\"],\n      \"childNoteIds\": [\"_search\", \"_globalNoteMap\", \"_options\"],\n      \"attributes\": [{ \"type\": \"label\", \"name\": \"excludeFromNoteMap\", \"value\": \"\" }]\n    }\n  ]\n}"
            }
          ]
        }
      ]
    },
